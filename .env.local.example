# =============================================================================
# ContractToCozy — Local Development Secrets
# =============================================================================
# Copy this file to .env.local and fill in every value.
# .env.local is gitignored and must NEVER be committed.
#
# Start the stack with:
#   docker compose --env-file .env.local up
#
# Generate strong random values with:
#   openssl rand -hex 32
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=changeme-use-openssl-rand-hex-32

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=changeme-use-openssl-rand-hex-32

# --- JWT signing keys (one per token type) ------------------------------------
JWT_SECRET=changeme-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=changeme-use-openssl-rand-hex-32
JWT_MFA_SECRET=changeme-use-openssl-rand-hex-32

# --- Session & CSRF -----------------------------------------------------------
SESSION_SECRET=changeme-use-openssl-rand-hex-32
CSRF_SECRET=changeme-use-openssl-rand-hex-32

# --- MFA TOTP encryption (32-byte AES-256 key as 64 hex chars) ---------------
MFA_ENCRYPTION_KEY=changeme-use-openssl-rand-hex-32

# --- CORS (comma-separated list of allowed frontend origins) ------------------
# In development this defaults to http://localhost:3000 if left empty.
ALLOWED_ORIGINS=http://localhost:3000

# --- Optional services --------------------------------------------------------
GEMINI_API_KEY=
METRICS_BEARER_TOKEN=
SWAGGER_PASSWORD=

# --- Beta governance ---------------------------------------------------------
# Set to true before admitting any real users. Technical safety remains active.
ENFORCE_HUMAN_POLICY_APPROVALS=false

# --- Capability recommendations ---------------------------------------------
# Server-side Unified Home recommendation envelope. False returns a versioned
# empty response while preserving ranked Home Actions and Explore Tools.
CAPABILITY_RECOMMENDATIONS_ENABLED=true

# --- Worker execution policy (optional — sensible beta defaults apply if unset,
# see apps/backend/src/config/workerExecutionPolicy.ts) -----------------------
# Master switch for scheduled/polling automation (default: true).
# WORKER_AUTOMATION_ENABLED=true
# Controls worker-originated homeowner email/send effects (default: false).
# WORKER_OUTBOUND_NOTIFICATIONS_ENABLED=false
# REFINANCE_EXTERNAL_ALERTS_ENABLED=false
# Defaults to ALLOWLIST even when omitted. GENERAL must be an explicit
# post-pilot decision; recipient addresses are matched case-insensitively.
# REFINANCE_ALERT_ROLLOUT_MODE=ALLOWLIST
# REFINANCE_ALERT_RECIPIENT_EMAIL_ALLOWLIST=operator@example.com
# Refinance Web Push is independently fail-closed. Generate VAPID keys with
# `npx web-push generate-vapid-keys`; keep the private key server-side only.
# WEB_PUSH_DELIVERY_ENABLED=false
# REFINANCE_PUSH_ALERTS_ENABLED=false
# WEB_PUSH_VAPID_SUBJECT=mailto:operations@example.com
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# Controls scheduled calls to CPSC, weather, rates, permit, tax, neighborhood,
# and similar external sources (default: false).
# WORKER_EXTERNAL_INGEST_ENABLED=false
# NWS alerts without an authoritative end time expire only after this age and
# a fully successful fetch cycle (default: 48; bounded to 6–168 hours).
# RADAR_NWS_STALE_AFTER_HOURS=48
# Controls broad scheduled mutation/cleanup/backfill sweeps (default: false).
# WORKER_MUTATING_SWEEPS_ENABLED=false
# Allows capability-protected manual "Run Job" triggers (default: true).
# WORKER_MANUAL_TRIGGERS_ENABLED=true
# Optional future dual-control/human approval for high-impact manual jobs
# (default: false — must stay false until an approval workflow exists).
# ENFORCE_WORKER_MANUAL_TRIGGER_APPROVALS=false
# Per-job overrides take precedence over the group flags above:
#   WORKER_JOB_<NORMALIZED_JOB_KEY>_ENABLED=true|false
#   WORKER_JOB_<NORMALIZED_JOB_KEY>_LEASE_TTL_MS=<milliseconds>
# Crash-recovery safety-net TTL for the cron lease shared by scheduled ticks
# and manual triggers of the same job (default: 600000 = 10 minutes).
# CRON_LEASE_TTL_MS=600000

# --- Severe weather alerts (NOAA/NWS, api.weather.gov — free, no API key) -----
# NWS requires an identifying User-Agent on every request (not a secret,
# just a contact string per their API usage policy).
NWS_USER_AGENT=(contracttocozy.com, ops@contracttocozy.com)

# --- Address autocomplete (optional; manual property entry works without it) ---
# Enable Places API (New) and restrict this server-side key to that API.
GOOGLE_MAPS_API_KEY=
