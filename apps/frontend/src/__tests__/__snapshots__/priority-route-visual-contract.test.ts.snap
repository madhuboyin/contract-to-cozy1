      "flex items-center gap-3 rounded-xl border border-slate-100 bg-white px-4 py-3.5",
      "flex w-full items-center gap-3 rounded-xl border border-[hsl(var(--mobile-border-subtle))] bg-white px-4 py-3 text-left text-sm font-medium text-[hsl(var(--mobile-text-primary))] hover:border-[hsl(var(--mobile-brand-strong))] hover:bg-[hsl(var(--mobile-brand-strong))]/5 transition-colors",
      "flex-1",
