    "test:integration": "node --test $(find tests/integration -type f -name '*.test.js')",
    "test:e2e": "node --test $(find tests/e2e -type f -name '*.test.js')",
    "test:ask": "node --test $(find tests/ask -type f -name '*.test.js')",
    "test:watch": "node --test --watch $(find tests -type f -name '*.test.js')",
    "smoke:health-score-ui": "node scripts/healthScoreUiSmokeCheck.js",
    "acceptance:phase8": "node scripts/phase8-runtime-acceptance.js",
    "smoke:capability-discovery": "ts-node scripts/capability-discovery-smoke.ts",
    "drill:capability-kill-switches": "ts-node scripts/capability-kill-switch-drill.ts",
    "drill:capability-catalog-only": "ts-node scripts/capability-catalog-only-drill.ts",
    "review:capability-copy": "ts-node scripts/capability-copy-review.ts",
    "drill:capability-incident": "ts-node scripts/capability-incident-drill.ts",
    "drill:coverage-launch": "ts-node scripts/coverage-operational-drill.ts",
    "drill:ownership-costs": "ts-node scripts/ownership-cost-operational-drill.ts",
    "preflight:coverage-load": "ts-node scripts/coverage-load-preflight.ts",
    "preflight:coverage-mutations": "ts-node scripts/coverage-mutation-preflight.ts",
    "acceptance:phase3": "node --test tests/integration/phase3VerifiedClosure.db.test.js",
    "acceptance:phase6": "node --test tests/integration/phase6NewHomeControlledPilot.db.test.js",
    "acceptance:decision-thread-continuation": "node --test tests/integration/decisionThreadContinuationCertification.db.test.js",
    "lint:ssrf": "node scripts/check-ssrf-guards.js",
    "lint:notification-boundary": "node scripts/check-notification-boundary.js",
    "report:weekly": "ts-node scripts/weekly-retention-report.ts",
    "report:home-intelligence-phase0": "ts-node scripts/generate-home-intelligence-phase0-report.ts",
    "retention:ask": "node dist/scripts/askRetentionCleanup.js",
    "retention:ask:dev": "ts-node src/scripts/askRetentionCleanup.ts",
    "report:service-price-benchmarks": "ts-node src/scripts/reportServicePriceBenchmarkHealth.ts",
    "backfill:property-activation": "ts-node scripts/backfill-property-activation.ts",
    "bootstrap:admin-capabilities": "ts-node scripts/adminCapabilityBootstrap.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
