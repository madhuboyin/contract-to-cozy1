    "pretest:unit": "npm run prisma:generate",
    "test": "node --test $(find tests -type f -name '*.test.js')",
    "test:unit": "node --test $(find tests/unit -type f -name '*.test.js')",
    "test:phase2": "node --test tests/unit/phase2HomeActions.test.js tests/unit/phase2SourcePromotion.test.js tests/unit/personalizationUnifiedHomeLifecycle.test.js tests/unit/personalizationMaterializeRecommendations.test.js tests/unit/unifiedHomePropertyContextConvergence.test.js tests/unit/adminToolLifecycleMetrics.test.js tests/unit/toolLifecycleAnalytics.test.js tests/unit/toolDiscoveryAvailability.test.js tests/unit/riskAssetApplicability.test.js",
