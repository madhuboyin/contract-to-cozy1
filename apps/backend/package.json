    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^6.2.0",
    "pino": "^10.3.1",
    "pino-loki": "^2.3.0",
    "playwright": "^1.57.0",
    "prisma": "5.22.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
