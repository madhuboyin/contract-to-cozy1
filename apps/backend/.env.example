NODE_ENV=production
# Comma-separated list of frontend origins the backend will accept CORS requests from.
# Required in production. In development defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=https://contracttocozy.com,https://www.contracttocozy.com
PORT=8080
DATABASE_URL=postgresql://postgres:password@postgres:5432/contracttocozy
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
JWT_EMAIL_SECRET=replace-with-openssl-rand-hex-32
JWT_PASSWORD_RESET_SECRET=replace-with-openssl-rand-hex-32
# Public frontend base URL used to build password-reset links in emails.
# Example: https://contracttocozy.com
PASSWORD_RESET_BASE_URL=
# Google Gemini API Key (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key-here
# NOAA NCEI Climate Normals API token — request free at https://www.ncdc.noaa.gov/cdo-web/token
# Powers the Environment report's Climate Normals section. If unset, that
# section degrades to status:'unavailable' — nothing else depends on it.
NOAA_NCEI_TOKEN=
# REQUIRED in production — protects the /metrics endpoint from public access.
# Generate with: openssl rand -hex 32
# Set this same value in your Prometheus scrape config as a Bearer token.
METRICS_BEARER_TOKEN=
# REQUIRED in production — signs the double-submit CSRF cookie.
# Generate with: openssl rand -hex 32
CSRF_SECRET=
# REQUIRED in production — 32-byte AES-256 key used to encrypt TOTP secrets at rest.
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# REQUIRED in production — signs short-lived MFA challenge JWTs (5 min TTL).
# Generate with: openssl rand -hex 32
JWT_MFA_SECRET=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_FEATURE_BUDGET_TRACKER=true
NEXT_PUBLIC_FEATURE_VALUE_ESTIMATOR=true
NEXT_PUBLIC_FEATURE_FEEDBACK_WIDGET=true
NEXT_PUBLIC_FEATURE_MILESTONE_CELEBRATIONS=true
# Pilot-only. Only the exact value "true" disables email verification.
DISABLE_EMAIL_VERIFICATION=false
# Internal beta defaults to advisory human approvals. Set exact "true" before real-user launch.
ENFORCE_HUMAN_POLICY_APPROVALS=false
# Set false to disable contextual capability suggestions without affecting Home.
CAPABILITY_RECOMMENDATIONS_ENABLED=true
