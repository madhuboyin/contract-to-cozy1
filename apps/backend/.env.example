NODE_ENV=production
# Comma-separated list of frontend origins the backend will accept CORS requests from.
# Required in production. In development defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=https://contracttocozy.com,https://www.contracttocozy.com
PORT=8080
DATABASE_URL=postgresql://postgres:password@postgres:5432/contracttocozy
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
JWT_EMAIL_SECRET=replace-with-openssl-rand-hex-32
JWT_PASSWORD_RESET_SECRET=replace-with-openssl-rand-hex-32
# Public frontend base URL used to build password-reset links in emails.
# Example: https://contracttocozy.com
PASSWORD_RESET_BASE_URL=
# Google Gemini API Key (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key-here
# NOAA NCEI Climate Normals API token — request free at https://www.ncdc.noaa.gov/cdo-web/token
# Powers the Environment report's Climate Normals section. If unset, that
# section degrades to status:'unavailable' — nothing else depends on it.
NOAA_NCEI_TOKEN=
# REQUIRED in production — protects the /metrics endpoint from public access.
# Generate with: openssl rand -hex 32
# Set this same value in your Prometheus scrape config as a Bearer token.
METRICS_BEARER_TOKEN=
# REQUIRED in production — signs the double-submit CSRF cookie.
# Generate with: openssl rand -hex 32
CSRF_SECRET=
# REQUIRED in production — 32-byte AES-256 key used to encrypt TOTP secrets at rest.
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# REQUIRED in production — signs short-lived MFA challenge JWTs (5 min TTL).
# Generate with: openssl rand -hex 32
JWT_MFA_SECRET=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_FEATURE_BUDGET_TRACKER=true
NEXT_PUBLIC_FEATURE_VALUE_ESTIMATOR=true
NEXT_PUBLIC_FEATURE_FEEDBACK_WIDGET=true
NEXT_PUBLIC_FEATURE_MILESTONE_CELEBRATIONS=true
# Pilot-only. Only the exact value "true" disables email verification.
DISABLE_EMAIL_VERIFICATION=false
# Internal beta defaults to advisory human approvals. Set exact "true" before real-user launch.
ENFORCE_HUMAN_POLICY_APPROVALS=false
# Set false to disable contextual capability suggestions without affecting Home.
CAPABILITY_RECOMMENDATIONS_ENABLED=true
# Fail-closed. Shows qualified insurance market observations only after an
# Admin + MFA + INTEGRATION_MANAGE ingestion has recorded source rights,
# domain review, coverage basis, methodology, retrieval time, and expiry.
COVERAGE_MARKET_CONTEXT_ENABLED=false
# Real-user promotion remains blocked unless all three values are present and
# the capability's versioned governance reviews are approved. CI records the
# evidence version only after the Slice 10 acceptance suite passes; operations
# records the rollback version only after the matching runbook drill passes.
COVERAGE_REAL_USER_LAUNCH_ENABLED=false
COVERAGE_LAUNCH_EVIDENCE_VERSION=
COVERAGE_ROLLBACK_DRILL_VERSION=
# Comma-separated critical/high gap IDs. Any value blocks the coverage launch.
COVERAGE_UNCONTAINED_HIGH_RISK_GAP_IDS=
# Ownership Cost Intelligence is fail-closed for real-user launch. CI records
# the evidence version after the Slice 9 suite passes; operations records the
# drill version after the runbook exercise; named reviewers record approvals.
OWNERSHIP_COST_REAL_USER_LAUNCH_ENABLED=false
OWNERSHIP_COST_LAUNCH_EVIDENCE_VERSION=
OWNERSHIP_COST_OPERATIONAL_DRILL_VERSION=
# CI records these exact versions only after the target build passes the
# automated + manual accessibility and four-view responsive evidence reviews.
OWNERSHIP_COST_ACCESSIBILITY_EVIDENCE_VERSION=
OWNERSHIP_COST_RESPONSIVE_EVIDENCE_VERSION=
# Immutable ticket, report, or audit-record ID for the reviewed operations
# dashboard snapshot. Do not put secrets in this field.
OWNERSHIP_COST_OPERATIONS_REVIEW_EVIDENCE_ID=
OWNERSHIP_COST_ACCESSIBILITY_APPROVED=false
OWNERSHIP_COST_RESPONSIVE_APPROVED=false
OWNERSHIP_COST_CONTENT_SAFETY_APPROVED=false
OWNERSHIP_COST_COMMERCIAL_INTEGRITY_APPROVED=false
OWNERSHIP_COST_UNCONTAINED_HIGH_RISK_GAP_IDS=

# Optional verified renovation-authority JSON adapters. When unset or unhealthy,
# the product remains on explicitly labeled heuristics / unresolved research.
# Endpoints receive property/jurisdiction/scope query parameters and must return
# JSON with verified:true before their guidance can replace a heuristic.
RENOVATION_PERMIT_AUTHORITY_URL=
RENOVATION_PERMIT_AUTHORITY_LABEL=
RENOVATION_PERMIT_AUTHORITY_COVERAGE=
RENOVATION_PERMIT_AUTHORITY_TOKEN=
RENOVATION_TAX_AUTHORITY_URL=
RENOVATION_TAX_AUTHORITY_LABEL=
RENOVATION_TAX_AUTHORITY_COVERAGE=
RENOVATION_TAX_AUTHORITY_TOKEN=
RENOVATION_LICENSING_AUTHORITY_URL=
RENOVATION_LICENSING_AUTHORITY_LABEL=
RENOVATION_LICENSING_AUTHORITY_COVERAGE=
RENOVATION_LICENSING_AUTHORITY_TOKEN=
RENOVATION_ZONING_AUTHORITY_URL=
RENOVATION_ZONING_AUTHORITY_LABEL=
RENOVATION_ZONING_AUTHORITY_COVERAGE=
RENOVATION_ZONING_AUTHORITY_TOKEN=
