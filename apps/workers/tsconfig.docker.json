// apps/workers/tsconfig.docker.json
//
// W5 (items 1/2/4/5): used only inside the Docker build. Identical to
// tsconfig.json in every setting (extends it) except `paths` — the Docker
// build compiles the backend first and reads its declarations from the
// sibling dist artifact, so @worker-shared/* resolves there instead.
// Keeping this as an `extends` override (rather
// than a second hand-maintained tsconfig) is what guarantees local and
// Docker TypeScript never drift in strictness/module-resolution.
//
// This file previously held an unrelated, never-wired-up "risk module"
// experiment (strict: false, a hand-picked include list) — confirmed via
// repo-wide grep that nothing referenced it, so it was safe to repurpose
// for what its name actually promises.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@worker-shared/*": ["../backend/dist/*"]
    },
    // Every emitted file lives under ./src. This keeps dist/worker.js at the
    // exact path CMD expects.
    "rootDir": "./src"
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/shared/backend/homeRenovationAdvisor/homeRenovationAdvisor.controller.ts",
    "src/shared/backend/homeRenovationAdvisor/homeRenovationAdvisor.routes.ts",
    "src/shared/backend/homeRenovationAdvisor/export/**/*"
  ]
}
