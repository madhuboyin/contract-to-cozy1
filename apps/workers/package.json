{
  "name": "contract-to-cozy-workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/worker.ts",
    "build": "tsc",
    "start": "node dist/worker.js",
    "test": "node --test $(find tests -type f -name '*.test.js')",
    "lint:notification-boundary": "node scripts/check-notification-boundary.js",
    "lint:worker-import-boundary": "node scripts/check-worker-import-boundary.js",
    "postinstall": "npx prisma generate && cp -r ../backend/node_modules/@prisma/client node_modules/ && mkdir -p node_modules/.prisma && cp -r ../backend/node_modules/.prisma/client node_modules/.prisma/ || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@google/genai": "^1.33.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.65.0",
    "dotenv": "^16.3.1",
    "ioredis": "^5.11.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-loki": "^2.3.0",
    "playwright": "^1.57.0",
    "prom-client": "^15.1.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.11",
    "@types/nodemailer": "^6.4.14",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "schema": "../backend/prisma/schema.prisma"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.7.0",
    "uuid": "^11.1.1"
  }
}
